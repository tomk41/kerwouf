---
import { lien } from '../../lib/chemins';
import Squelette from '../../components/Squelette.astro';
import Navigation from '../../components/Navigation.astro';
import { c, lienTel, lienMail, telAffiche, adresseLigne } from '../../lib/contenu';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/inter';
import './styles.css';

interface Props { titre?: string; description?: string; accueil?: boolean }
const { titre, description, accueil = false } = Astro.props;
const prefixe = accueil ? '' : lien('v6/');
---

<Squelette n={6} titre={titre ? `${titre} – Ker Wouf` : undefined} description={description} jsonLd={accueil}>
  <header slot="entete" class="entete">
    <div class="cadre entete__in">
      <a class="marque" href={lien('v6/')}>{c.site.nom}</a>
      <Navigation prefixe={prefixe} />
      <a class="entete__tel" href={lienTel} aria-label={`Appeler le ${telAffiche}`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        <span class="entete__num">{telAffiche}</span>
      </a>
    </div>
  </header>

  <slot />

  <footer slot="pied" class="pied">
    <div class="cadre pied__in">
      <p class="pied__nom">{c.site.nom}</p>
      <p class="pied__base">{c.site.baseline}</p>
      <address>{adresseLigne}<br /><a href={lienTel}>{telAffiche}</a> · <a href={lienMail}>{c.site.email}</a></address>
      <p class="pied__liens">
        <a href={lien('v6/mentions-legales/')}>{c.pied_de_page.mentions}</a>
        <a href={lien('v6/confidentialite/')}>{c.pied_de_page.confidentialite}</a>
      </p>
      <p class="pied__copy">© 2026 {c.site.nom}</p>
    </div>
  </footer>
</Squelette>
