---
// Petites illustrations rétro en SVG (décoratives) : chien, maison, chemin, arcs.
interface Props { nom: 'chien' | 'maison' | 'chemin' | 'arcs'; class?: string }
const { nom, class: classe } = Astro.props;
const C = { moutarde: '#e0a526', orange: '#b1461a', olive: '#5f6b2b', creme: '#f6ecd6', brun: '#3b2413', ardoise: '#4a4f57' };
---

{nom === 'chien' && (
  <svg class={classe} viewBox="0 0 180 140" aria-hidden="true" focusable="false">
    <path d="M46 84 C26 78 18 60 24 44" fill="none" stroke={C.orange} stroke-width="11" stroke-linecap="round" />
    <rect x="38" y="72" width="88" height="44" rx="22" fill={C.orange} />
    <rect x="48" y="104" width="13" height="28" rx="6" fill={C.orange} />
    <rect x="104" y="104" width="13" height="28" rx="6" fill={C.orange} />
    <rect x="66" y="108" width="12" height="24" rx="6" fill="#8f3815" />
    <circle cx="132" cy="62" r="26" fill={C.orange} />
    <ellipse cx="155" cy="72" rx="14" ry="10" fill={C.creme} />
    <circle cx="166" cy="69" r="5" fill={C.brun} />
    <ellipse cx="120" cy="56" rx="9" ry="19" fill={C.brun} transform="rotate(18 120 56)" />
    <circle cx="140" cy="55" r="3.5" fill={C.brun} />
    <rect x="108" y="80" width="30" height="8" rx="4" fill={C.moutarde} transform="rotate(-14 123 84)" />
    <line x1="10" y1="133" x2="170" y2="133" stroke={C.brun} stroke-width="3" stroke-linecap="round" />
  </svg>
)}

{nom === 'maison' && (
  <svg class={classe} viewBox="0 0 200 150" aria-hidden="true" focusable="false">
    <rect x="132" y="20" width="16" height="34" fill={C.brun} />
    <polygon points="8,70 100,16 192,70" fill={C.ardoise} />
    <rect x="22" y="68" width="156" height="72" fill={C.moutarde} stroke={C.brun} stroke-width="3" />
    <g fill={C.creme} opacity="0.45">
      <rect x="30" y="80" width="20" height="8" rx="3" /><rect x="58" y="78" width="16" height="7" rx="3" />
      <rect x="140" y="118" width="22" height="8" rx="3" /><rect x="34" y="122" width="14" height="7" rx="3" />
      <rect x="150" y="82" width="18" height="7" rx="3" />
    </g>
    <rect x="88" y="94" width="26" height="46" rx="3" fill={C.olive} stroke={C.brun} stroke-width="3" />
    <rect x="40" y="94" width="28" height="24" fill={C.creme} stroke={C.brun} stroke-width="3" />
    <rect x="134" y="94" width="28" height="24" fill={C.creme} stroke={C.brun} stroke-width="3" />
    <rect x="32" y="94" width="8" height="24" fill={C.olive} /><rect x="68" y="94" width="8" height="24" fill={C.olive} />
    <rect x="126" y="94" width="8" height="24" fill={C.olive} /><rect x="162" y="94" width="8" height="24" fill={C.olive} />
    <line x1="4" y1="141" x2="196" y2="141" stroke={C.brun} stroke-width="3" stroke-linecap="round" />
  </svg>
)}

{nom === 'chemin' && (
  <svg class={classe} viewBox="0 0 240 150" aria-hidden="true" focusable="false">
    <path d="M60 80 A60 60 0 0 1 180 80" fill="none" stroke={C.moutarde} stroke-width="12" />
    <path d="M78 80 A42 42 0 0 1 162 80" fill="none" stroke={C.orange} stroke-width="12" />
    <path d="M96 80 A24 24 0 0 1 144 80" fill={C.olive} stroke={C.olive} stroke-width="0" />
    <path d="M0 92 C50 70 90 98 130 84 S210 70 240 86 V150 H0 Z" fill={C.olive} />
    <path d="M118 88 C112 104 150 112 128 126 C112 136 96 140 88 150 H150 C156 138 182 128 168 114 C156 102 126 102 132 88 Z" fill={C.creme} />
    <g fill="#3f4720"><circle cx="40" cy="78" r="14" /><circle cx="204" cy="74" r="16" /><circle cx="222" cy="86" r="10" /></g>
    <g fill={C.brun}><rect x="38" y="88" width="4" height="14" /><rect x="202" y="86" width="4" height="16" /></g>
  </svg>
)}

{nom === 'arcs' && (
  <svg class={classe} viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 100 A100 100 0 0 1 200 100" fill={C.moutarde} />
    <path d="M11 100 A89 89 0 0 1 189 100" fill={C.orange} />
    <path d="M22 100 A78 78 0 0 1 178 100" fill={C.olive} />
    <path d="M33 100 A67 67 0 0 1 167 100" fill={C.creme} />
  </svg>
)}
