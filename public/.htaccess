# ==========================================================================
#  Bêta Ker Wouf : servie sous https://kerwouf.fr/beta/ (dossier www/beta/ chez OVH)
#  Le WordPress du dossier parent (www/) gère le domaine, le HTTPS et le www :
#  ce fichier ne s'applique qu'au dossier beta/.
# ==========================================================================

# Neutralise les règles de réécriture du WordPress parent (sinon /beta/... serait
# renvoyé vers index.php de WordPress). Pas de redirection HTTPS ni www ici.
RewriteEngine Off

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /beta/404.html
AddDefaultCharset UTF-8

# --- Fichiers à ne jamais servir --------------------------------------------
# Fichier d'état de FTP-Deploy-Action (liste des fichiers déployés)
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- En-têtes ----------------------------------------------------------------
<IfModule mod_headers.c>
  # Bêta : aucune indexation par les moteurs de recherche
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Fichiers générés par Astro (nom contenant une empreinte) : cache d'un an
  <If "%{REQUEST_URI} =~ m#^/beta/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages HTML : toujours revalidées, pour voir les mises à jour tout de suite
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Cache navigateur ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# --- Compression ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
